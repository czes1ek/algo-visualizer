#!/bin/sh
# Rejects AI attribution in commit messages (Casper's standing rule).
if grep -qiE '^(co-authored-by:|.*generated with \[?claude)|noreply@anthropic\.com|claude-session:' "$1"; then
  echo "commit-msg hook: AI attribution lines are not allowed in this repo. Remove them and commit again." >&2
  exit 1
fi
exit 0
